{
  "name": "personal-assistant",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "lint": "biome lint src tests scripts/spending.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --test tests/db/*.test.ts",
    "spending": "tsx --env-file=.env scripts/spending.ts",
    "dev": "tsx watch --env-file=.env --import ./src/instrument.ts src/index.ts",
    "build": "pnpm build:faq && tsc",
    "start": "node --import ./dist/src/instrument.js dist/src/index.js",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "db:push": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs push",
    "build:faq": "esbuild scripts/browser/faq.ts --bundle --minify --format=iife --outfile=public/faq.js"
  },
  "dependencies": {
    "@daytona/sdk": "^0.227.0",
    "@hono/node-server": "^2.1.3",
    "@linqapp/sdk": "^0.78.0",
    "@neon/ai-sdk-provider": "^1.3.0",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@sentry/node": "^11.11.0",
    "@trigger.dev/sdk": "4.8.3",
    "ai": "^7.0.157",
    "drizzle-orm": "^0.45.4",
    "firecrawl-aisdk": "^0.13.1",
    "hono": "^4.13.14",
    "motion": "^14.10.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@hono/cli": "^1.0.0-rc.8",
    "@sentry/esbuild-plugin": "^11.11.0",
    "@trigger.dev/build": "4.8.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
